{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "aegis-backend",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "cd backend && .venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8000 --reload --reload-include '*.yaml'"
      ],
      "port": 8000
    },
    {
      "name": "aegis-backend-sqlite",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "cd backend && DATABASE_URL=sqlite:///./aegis.db .venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8000 --reload --reload-include '*.yaml'"
      ],
      "port": 8000
    },
    {
      "name": "aegis-frontend",
      "runtimeExecutable": "sh",
      "runtimeArgs": ["-c", "cd frontend && npm run dev"],
      "port": 5173
    }
  ]
}
