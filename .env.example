# ---------------------------------------------------------------------------
# AEGIS-X environment configuration
#
#   cp .env.example .env
#
# Every value below has a working default in code, so an empty .env still
# boots. Docker Compose reads this file automatically.
# ---------------------------------------------------------------------------

# --- Service ---------------------------------------------------------------
ENVIRONMENT=development
DEBUG=true

# --- PostgreSQL ------------------------------------------------------------
# Used by both the `db` container and the backend's connection settings.
POSTGRES_USER=aegis
POSTGRES_PASSWORD=aegis
POSTGRES_DB=aegis
POSTGRES_PORT=5432

# Only needed when running the backend directly on the host (not in Compose).
# Compose overrides this to point at the `db` service.
POSTGRES_HOST=localhost

# Optional: set to override the assembled connection URL entirely.
# DATABASE_URL=postgresql+psycopg://aegis:aegis@localhost:5432/aegis

# --- CORS ------------------------------------------------------------------
# Comma-separated list of origins permitted to call the API.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Frontend --------------------------------------------------------------
# Backend base URL as seen from the browser.
VITE_API_BASE=http://localhost:8000

# --- Instruction parsing (LLM) ---------------------------------------------
# The agent converts natural language into a structured action proposal.
# A deterministic parser is always available, so NO KEY IS REQUIRED -- setting
# one simply swaps in Gemini behind the same interface.
#
#   auto      (default) Gemini when GEMINI_API_KEY is set, deterministic otherwise
#   gemini    force Gemini (still falls back if a call fails)
#   heuristic force the deterministic parser, never make a network call
LLM_PROVIDER=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
LLM_TIMEOUT_SECONDS=8.0
